# --- Base de datos ---
# Desarrollo local: fichero SQLite dentro del proyecto.
DATABASE_URL="file:./dev.db"
#
# Producción en contenedor (Easypanel, Docker): la base de datos DEBE apuntar a
# un volumen persistente montado, o cada redespliegue borrará todos los datos.
# DATABASE_URL="file:/data/app.db"

# Secreto para firmar las cookies de sesión (JWT).
# Genera uno propio con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="cambia-este-secreto-en-produccion-por-uno-largo-y-aleatorio"

# --- Integración Lodgify (opcional) ---
# Si se deja vacío, la sincronización usa datos de demostración ficticios
# para poder probar todo el flujo sin credenciales reales.
LODGIFY_API_KEY=""

# --- Arranque en contenedor (opcional) ---
# Siembra los datos de ejemplo solo si la base de datos está vacía. Ponlo a
# "false" para no sembrar nunca (p. ej. si vas a cargar datos reales a mano).
# SEED_ON_FIRST_RUN="true"
