# Base de datos (Prisma + PostgreSQL, alojada en Supabase).
#
# DATABASE_URL usa el connection pooler de Supabase (Supavisor, modo
# "transaction", puerto 6543) para las consultas normales de la app —
# necesario en la mayoría de hostings porque Supabase ya no expone conexión
# directa por IPv4. `pgbouncer=true` desactiva el prepared-statement caching
# de Prisma (incompatible con el modo transacción del pooler).
DATABASE_URL="postgresql://usuario:password@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# DIRECT_URL usa el pooler en modo "session" (puerto 5432): lo necesitan
# `prisma migrate` / `prisma db push`, que no funcionan a través del modo
# transacción.
DIRECT_URL="postgresql://usuario:password@aws-0-eu-west-1.pooler.supabase.com:5432/postgres"

# Secreto para firmar las cookies de sesión (JWT). Genera uno propio en
# producción, por ejemplo con: openssl rand -hex 32
AUTH_SECRET="cambia-este-secreto-en-produccion-por-uno-largo-y-aleatorio"

# --- Integración Lodgify (opcional) ---
# Si se deja vacío, la sincronización usa datos de demostración ficticios
# para poder probar todo el flujo sin credenciales reales.
LODGIFY_API_KEY=""
