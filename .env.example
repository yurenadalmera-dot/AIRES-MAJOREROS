# Base de datos (Prisma + MySQL del hosting de Hostinger).
#
# Formato:
#
#   mysql://USUARIO:CONTRASEÑA@HOST:3306/NOMBRE_BASE
#
# ⚠️ En producción el HOST tiene que ser `localhost`, NO el nombre público del
# servidor (srv0000.hstgr.io). El usuario de MySQL solo tiene permiso desde
# localhost, y con el nombre público la conexión se rechaza con un error que
# habla de credenciales inválidas aunque la contraseña sea correcta.
#
# El usuario y el nombre de la base los prefija Hostinger con el identificador
# de la cuenta (u1436xxxxx_). Se consultan en hPanel → Bases de datos → MySQL.
#
# Si la contraseña lleva caracteres especiales (@ : / ? # etc.), hay que
# codificarlos en porcentaje o la URL se parte por el sitio equivocado.
DATABASE_URL="mysql://usuario:password@localhost:3306/basededatos"

# Secreto para firmar las cookies de sesión (JWT). Genera uno propio en
# producción, por ejemplo con: openssl rand -hex 32
AUTH_SECRET="cambia-este-secreto-en-produccion-por-uno-largo-y-aleatorio"

# --- Cuenta de administración (opcional, pero necesaria en producción) ---
# El seed da de alta esta cuenta en cada despliegue y le restablece la
# contraseña, de forma que siempre haya una vía de entrada aunque la siembra de
# demostración se salte por haber ya datos.
#
# Si ADMIN_PASSWORD se deja vacío no se crea ni se modifica ninguna cuenta.
# La contraseña nunca debe escribirse en el repositorio: va en las variables de
# entorno del hosting.
ADMIN_EMAIL="info@airesmajoreros.pro"
ADMIN_PASSWORD=""

# --- Integración Lodgify (opcional) ---
# Si se deja vacío, la sincronización usa datos de demostración ficticios
# para poder probar todo el flujo sin credenciales reales.
LODGIFY_API_KEY=""
