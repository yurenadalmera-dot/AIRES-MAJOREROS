# Base de datos (Prisma). Para desarrollo/demo se usa SQLite local.
# En producción, sustituir por una cadena de conexión PostgreSQL:
# DATABASE_URL="postgresql://usuario:password@host:5432/basededatos"
DATABASE_URL="file:./dev.db"

# Secreto para firmar las cookies de sesión (JWT).
# OBLIGATORIO en cualquier despliegue con base de datos propia: sin él no se
# pueden firmar las sesiones y el inicio de sesión devuelve un error. Genera uno
# largo y aleatorio, por ejemplo con:  openssl rand -base64 48
AUTH_SECRET="cambia-este-secreto-en-produccion-por-uno-largo-y-aleatorio"

# --- Modo demo (opcional) ---
# Vista previa autocontenida con los datos de ejemplo incluidos en el despliegue
# (ver lib/demo-mode.ts). Se activa solo en un build de producción sin base de
# datos de servidor configurada; aquí se puede forzar o desactivar a mano:
#   DEMO_MODE=1  -> siempre datos de demostración
#   DEMO_MODE=0  -> nunca; se usa DATABASE_URL (requiere AUTH_SECRET)
# DEMO_MODE=""

# --- Integración Lodgify (opcional) ---
# Si se deja vacío, la sincronización usa datos de demostración ficticios
# para poder probar todo el flujo sin credenciales reales.
LODGIFY_API_KEY=""
