// Schema de datos para la plataforma de gestión de alquileres vacacionales
// y facturación de limpiezas.
//
// Nota sobre "enums": los campos que podrían ser enum se modelan como String,
// con los valores válidos documentados y validados en la capa de aplicación
// (ver lib/constants.ts). Eso mantiene el modelo portable entre motores: el
// "datasource" es el único cambio real entre entornos.
//
// Producción: MySQL del propio hosting de Hostinger, incluido en el plan y en
// la misma máquina que la aplicación, que se conecta por `localhost:3306`.
// Se eligió frente a una base de datos externa por tres razones: no añade
// coste, da 3 GB (frente a los 500 MB del plan gratuito de Supabase) y evita
// la capa de connection pooler, que fue la fuente del fallo de conexión más
// difícil de diagnosticar de este proyecto.
//
// El esquema NO se aplica durante el build. El build de Hostinger corre en un
// contenedor aparte, y esta base solo acepta conexiones desde el propio
// servidor de hosting: desde el build, la autenticación se rechaza (P1000),
// aunque la contraseña sea correcta.
//
// Lo aplica la propia aplicación al arrancar (`instrumentation.ts`), que es el
// único proceso con acceso: crea el esquema si falta (`lib/preparar-base.ts`) y
// aplica los cambios posteriores (`lib/migraciones.ts`). Ver el README.

generator client {
  provider = "prisma-client-js"
  // "native" para desarrollo local; el target de RHEL es el que usa el runtime
  // de Node en Hostinger, necesario para que el motor de Prisma funcione allí.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Multi-tenant / cuenta
// ---------------------------------------------------------------------------

/// Organización cliente de la plataforma. Permite vender la misma app a
/// otras empresas del sector sin tocar código: cada una es una Organization
/// con sus propios Business, viviendas, empleadas, integraciones, etc.
model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  businesses  Business[]
  owners      Owner[]
  properties  Property[]
  employees   Employee[]
  bookings    Booking[]
  cleaningTasks CleaningTask[]
  partners    Partner[]
  invoices    Invoice[]
  users       User[]
  integrationSettings IntegrationSettings[]
  partnerSplitConfigs PartnerSplitConfig[]
  channelCommissions  ChannelCommission[]
  expenses            Expense[]
  propertyGroups      PropertyGroup[]
}

/// Una "unidad de negocio" dentro de la organización. type identifica su
/// función funcional dentro de la app (RENTAL_MANAGEMENT / CLEANING_BILLING)
/// pero el nombre visible es libre, para no hardcodear "Emma"/"Aires".
model Business {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  type           String   // RENTAL_MANAGEMENT | CLEANING_BILLING
  name           String
  legalName      String?  // razón social / nombre fiscal a mostrar en informes y facturas
  taxId          String?  // NIF/CIF
  contactEmail   String?
  contactPhone   String?
  /// Domicilio fiscal. Una factura sin el domicilio de quien la emite no es
  /// válida (art. 6 del Reglamento de facturación).
  address        String?  @db.Text
  /// Tipo impositivo que se repercute, en porcentaje. Aquí es IGIC, no IVA:
  /// en Canarias el tipo general es el 7 %. Se copia a cada factura al
  /// emitirla, para que cambiarlo no altere las ya emitidas.
  taxRate        Decimal  @default(7)
  createdAt      DateTime @default(now())

  @@unique([organizationId, type])
}

// ---------------------------------------------------------------------------
// Negocio de alquiler vacacional (Emma)
// ---------------------------------------------------------------------------

model Owner {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  email          String?
  phone          String?
  notes          String?  @db.Text
  /// NIF/CIF y domicilio: hacen falta para facturarle.
  taxId          String?
  address        String?  @db.Text
  /// Cuota fija mensual de gestión, si la hay. Academia Cañada paga 600 € al
  /// mes en vez de un porcentaje.
  monthlyFee     Decimal?
  createdAt      DateTime @default(now())

  properties Property[]
  expenses   Expense[]
  groups     PropertyGroup[]

  @@index([organizationId])
}

model Property {
  id                String   @id @default(cuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id])
  ownerId           String?
  owner             Owner?   @relation(fields: [ownerId], references: [id])
  name              String
  locality           String  // localidad en Fuerteventura (Corralejo, Costa Calma...)
  address           String?
  capacity          Int      @default(2)
  bedrooms          Int      @default(1)
  bathrooms         Int      @default(1)
  active            Boolean  @default(true)
  cleaningPrice     Decimal  @default(0)
  /// Solo para una vivienda suelta, que no pertenezca a ningún grupo. Lo
  /// normal es que la comisión venga del grupo: ver `PropertyGroup`.
  managementPct     Decimal?
  groupId           String?
  group             PropertyGroup? @relation(fields: [groupId], references: [id]) // precio que Aires Majoreros factura por limpieza estándar de esta vivienda
  manualStatus      String?  // override manual opcional: OCCUPIED | AVAILABLE | CLEANING_NEEDED | MAINTENANCE
  lodgifyPropertyId String?  @unique // para emparejar con la integración Lodgify
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  bookings      Booking[]
  cleaningTasks CleaningTask[]
  channelCommissions ChannelCommission[]
  expenses      Expense[]

  @@index([organizationId])
}

model Employee {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  role           String   @default("CLEANING") // CLEANING | MAINTENANCE | BOTH
  phone          String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  cleaningTasks CleaningTask[]

  @@index([organizationId])
}

/// Reserva. Puede venir de Lodgify (lodgifyBookingId presente) o creada a
/// mano. manuallyAdjusted protege la reserva de ser sobrescrita por el sync.
model Booking {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  propertyId     String
  property       Property @relation(fields: [propertyId], references: [id])

  lodgifyBookingId String? @unique // clave única para upsert idempotente desde Lodgify

  guestName  String
  guestEmail String?
  guestPhone String?
  adults     Int    @default(1)
  children   Int    @default(0)

  checkIn  DateTime
  checkOut DateTime

  channel String @default("DIRECTO") // Airbnb | Booking.com | Lodgify | Directo | ... (lista configurable)
  status  String @default("CONFIRMED") // CONFIRMED | CANCELLED

  totalPrice             Decimal
  platformCommissionPct  Decimal @default(0)
  platformCommissionAmt  Decimal @default(0)
  bankCommissionPct      Decimal @default(0)
  bankCommissionAmt      Decimal @default(0)
  netAmount              Decimal @default(0)

  manuallyAdjusted Boolean @default(false) // true = el sync de Lodgify nunca debe tocar esta reserva
  notes            String?  @db.Text

  source    String   @default("MANUAL") // MANUAL | LODGIFY
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cleaningTasks CleaningTask[]

  @@index([organizationId])
  @@index([propertyId])
  @@index([checkIn])
  @@index([checkOut])
}

/// Registro compartido entre los dos negocios: es a la vez tarea operativa
/// (Emma: calendario/asignación) y línea facturable (Aires Majoreros:
/// facturación), sin duplicarse en dos tablas distintas.
model CleaningTask {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  propertyId     String
  property       Property @relation(fields: [propertyId], references: [id])

  bookingId String?  // limpieza asociada a la salida de esta reserva (opcional)
  booking   Booking? @relation(fields: [bookingId], references: [id])

  type   String @default("CLEANING") // CLEANING | MAINTENANCE
  date   DateTime
  status String @default("PENDING") // PENDING | IN_PROGRESS | DONE | CANCELLED

  employeeId String?
  employee   Employee? @relation(fields: [employeeId], references: [id])

  billable Boolean @default(true) // solo las de type=CLEANING generan factura a Aires Majoreros
  price    Decimal @default(0)    // importe que se factura por esta limpieza

  invoiceId String?
  invoice   Invoice? @relation(fields: [invoiceId], references: [id])

  notes     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([propertyId])
  @@index([date])
  @@index([status])
  @@index([invoiceId])
}

// ---------------------------------------------------------------------------
// Negocio de facturación de limpiezas (Aires Majoreros)
// ---------------------------------------------------------------------------

model Partner {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  email          String?
  createdAt      DateTime @default(now())

  @@index([organizationId])
}

/// Reparto configurable del importe facturado entre las socias. Por defecto
/// 50/50, pero editable y con vigencia temporal (effectiveFrom) para permitir
/// cambios futuros sin perder el histórico.
model PartnerSplitConfig {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  partnerAId     String
  partnerBId     String
  partnerAPercent Decimal @default(50)
  partnerBPercent Decimal @default(50)
  effectiveFrom  DateTime @default(now())
  createdAt      DateTime @default(now())

  @@index([organizationId])
}

model Invoice {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  invoiceNumber String   @unique
  billedToName  String   // cliente facturado (p.ej. la razón social del negocio de alquiler)
  billedToTaxId String?
  /// Domicilio del destinatario, también obligatorio en la factura.
  billedToAddress String? @db.Text
  periodStart   DateTime
  periodEnd     DateTime
  issueDate     DateTime @default(now())
  status        String   @default("DRAFT") // DRAFT | ISSUED | PAID

  /// Base imponible: la suma de las líneas, antes de impuestos.
  subtotal Decimal @default(0)
  /// Tipo y cuota del impuesto, tal como estaban el día de emitirla. Se
  /// guardan en la factura y no se recalculan: una factura emitida no cambia.
  taxRate   Decimal @default(7)
  taxAmount Decimal @default(0)
  /// Base imponible + cuota.
  total    Decimal @default(0)

  partnerAId      String?
  partnerBId      String?
  partnerAPercent Decimal @default(50)
  partnerBPercent Decimal @default(50)
  partnerAAmount  Decimal @default(0)
  partnerBAmount  Decimal @default(0)

  notes     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines         CleaningTask[]
  invoiceLines  InvoiceLine[]

  @@index([organizationId])
}

/// Copia inmutable de cada línea en el momento de facturar (snapshot), para
/// que la factura no cambie si luego se edita la vivienda o el precio.
model InvoiceLine {
  id            String   @id @default(cuid())
  invoiceId     String
  invoice       Invoice  @relation(fields: [invoiceId], references: [id])
  cleaningTaskId String?
  description   String
  propertyName  String
  date          DateTime
  amount        Decimal

  @@index([invoiceId])
}

// ---------------------------------------------------------------------------
// Integraciones y configuración
// ---------------------------------------------------------------------------

/// Comisión que se lleva cada canal de venta.
///
/// Antes había un único porcentaje para todo, y no es así: Airbnb se lleva el
/// 15 % y Booking.com el 18 %. Aplicar el mismo a las dos descuadra el neto de
/// cada reserva, y con él los informes del año.
///
/// El canal se guarda tal cual lo manda Lodgify, pero se compara en minúsculas
/// y sin espacios: «Booking.com», «booking.com» y «BOOKING.COM» son el mismo.
model ChannelCommission {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  /// Nombre del canal tal como lo manda Lodgify.
  channel        String
  /// Si se indica, esta comisión vale solo para esa vivienda; si es nula, vale
  /// para todas las de ese canal. Booking no cobra lo mismo a todos los pisos:
  /// en los datos reales son 17 % en dos de ellos y 15 % en el resto.
  propertyId     String?
  property       Property? @relation(fields: [propertyId], references: [id])
  platformPct    Decimal  @default(0)
  /// Comisión bancaria de este canal. Nula = la general. Airbnb no cobra
  /// ninguna; Booking, un 1,3 %.
  bankPct        Decimal?
  createdAt      DateTime @default(now())

  @@unique([organizationId, channel, propertyId])
  @@index([organizationId])
  @@index([propertyId])
}

/// Un grupo de viviendas de un mismo propietario, con su comisión.
///
/// Inversiones Brito tiene dos, y cobran distinto: el Grupo Villa Mónica al
/// 30 % y Villa Monikka al 10 %. Sin esto habría que repetir el porcentaje en
/// cada una de las once viviendas, y a la primera que se olvidara, descuadra.
///
/// La cuota fija (Academia Cañada, 600 € al mes) no va aquí: esa es del
/// propietario entero, no de un grupo.
model PropertyGroup {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  ownerId        String
  owner          Owner    @relation(fields: [ownerId], references: [id])
  name           String
  /// Lo que se lleva Aires por gestionar las viviendas de este grupo, sobre
  /// lo que queda después de las comisiones de venta y de los gastos.
  managementPct  Decimal?
  createdAt      DateTime @default(now())

  properties Property[]

  @@index([organizationId])
  @@index([ownerId])
}

/// Un gasto de una vivienda: luz, agua, una reparación, la comunidad.
///
/// Hace falta para los informes al propietario: la comisión de gestión se
/// calcula sobre lo que queda **después de gastos**, así que sin ellos el
/// número sale siempre alto. Los sube Emma.
model Expense {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  /// La vivienda a la que se imputa. Si es nula, es un gasto del propietario
  /// que no va contra una casa concreta.
  propertyId     String?
  property       Property? @relation(fields: [propertyId], references: [id])
  ownerId        String?
  owner          Owner?    @relation(fields: [ownerId], references: [id])

  date           DateTime
  concept        String
  supplier       String?
  amount         Decimal  @default(0)
  notes          String?  @db.Text

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId])
  @@index([propertyId])
  @@index([date])
}

model IntegrationSettings {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  provider       String   @default("LODGIFY")

  apiKeyMasked        String? // versión enmascarada, para enseñarla sin enseñarla
  /// Clave de API cifrada con AES-256-GCM (ver `lib/secretos.ts`). Antes no
  /// se guardaba: la que se escribía en Ajustes se tiraba y la sincronización
  /// seguía en modo demostración sin decir nada.
  apiKeyCifrada       String? @db.Text
  defaultPlatformPct  Decimal @default(15)
  defaultBankPct      Decimal @default(2.5)
  syncEnabled         Boolean @default(true)
  lastSyncAt          DateTime?
  lastSyncSummary     String?  @db.Text

  @@unique([organizationId, provider])
}

// ---------------------------------------------------------------------------
// Usuarios / acceso
// ---------------------------------------------------------------------------

model User {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  email          String   @unique
  passwordHash   String
  role           String   @default("STAFF") // ADMIN | RENTAL_MANAGER | PARTNER | STAFF
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  @@index([organizationId])
}
