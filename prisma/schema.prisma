// Schema de datos para la plataforma de gestión de alquileres vacacionales
// y facturación de limpiezas.
//
// Nota sobre "enums": los campos que podrían ser enum se modelan como String,
// con los valores válidos documentados y validados en la capa de aplicación
// (ver lib/constants.ts). Eso mantiene el modelo portable entre motores: el
// "datasource" es el único cambio real entre entornos.
//
// Producción: MySQL del propio hosting de Hostinger, incluido en el plan y en
// la misma máquina que la aplicación, que se conecta por `localhost:3306`.
// Se eligió frente a una base de datos externa por tres razones: no añade
// coste, da 3 GB (frente a los 500 MB del plan gratuito de Supabase) y evita
// la capa de connection pooler, que fue la fuente del fallo de conexión más
// difícil de diagnosticar de este proyecto.
//
// El esquema NO se aplica durante el build. El build de Hostinger corre en un
// contenedor aparte, y esta base solo acepta conexiones desde el propio
// servidor de hosting: desde el build, la autenticación se rechaza (P1000),
// aunque la contraseña sea correcta.
//
// Lo aplica la propia aplicación al arrancar (`instrumentation.ts`), que es el
// único proceso con acceso: crea el esquema si falta (`lib/preparar-base.ts`) y
// aplica los cambios posteriores (`lib/migraciones.ts`). Ver el README.

generator client {
  provider      = "prisma-client-js"
  // "native" para desarrollo local; el target de RHEL es el que usa el runtime
  // de Node en Hostinger, necesario para que el motor de Prisma funcione allí.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Multi-tenant / cuenta
// ---------------------------------------------------------------------------

/// Organización cliente de la plataforma. Permite vender la misma app a
/// otras empresas del sector sin tocar código: cada una es una Organization
/// con sus propios Business, viviendas, empleadas, integraciones, etc.
model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  businesses          Business[]
  owners              Owner[]
  properties          Property[]
  employees           Employee[]
  bookings            Booking[]
  cleaningTasks       CleaningTask[]
  partners            Partner[]
  invoices            Invoice[]
  users               User[]
  integrationSettings IntegrationSettings[]
  partnerSplitConfigs PartnerSplitConfig[]
  channelCommissions  ChannelCommission[]
  expenses            Expense[]
  documentosOcr       DocumentoOcr[]
  tarifas             Tarifa[]
  propertyGroups      PropertyGroup[]
}

/// Una "unidad de negocio" dentro de la organización. type identifica su
/// función funcional dentro de la app (RENTAL_MANAGEMENT / CLEANING_BILLING)
/// pero el nombre visible es libre, para no hardcodear "Emma"/"Aires".
model Business {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  type           String // RENTAL_MANAGEMENT | CLEANING_BILLING
  name           String
  legalName      String? // razón social / nombre fiscal a mostrar en informes y facturas
  taxId          String? // NIF/CIF
  contactEmail   String?
  contactPhone   String?
  /// Domicilio fiscal. Una factura sin el domicilio de quien la emite no es
  /// válida (art. 6 del Reglamento de facturación).
  address        String?      @db.Text
  /// Tipo impositivo que se repercute, en porcentaje. Aquí es IGIC, no IVA:
  /// en Canarias el tipo general es el 7 %. Se copia a cada factura al
  /// emitirla, para que cambiarlo no altere las ya emitidas.
  taxRate        Decimal      @default(7)
  createdAt      DateTime     @default(now())

  @@unique([organizationId, type])
}

// ---------------------------------------------------------------------------
// Negocio de alquiler vacacional (Emma)
// ---------------------------------------------------------------------------

model Owner {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  email          String?
  phone          String?
  notes          String?      @db.Text
  /// NIF/CIF y domicilio: hacen falta para facturarle.
  taxId          String?
  address        String?      @db.Text
  /// Cuota fija mensual de gestión **vigente hoy**, si la hay: es lo que se
  /// enseña y lo que se escribe en Ajustes. El histórico está en `cuotas`, y
  /// es ese el que manda al liquidar.
  monthlyFee     Decimal?
  monthlyFeeDesde DateTime?
  createdAt      DateTime     @default(now())

  /// La lista de precios de limpieza que se le aplica.
  tarifaId String?
  tarifa   Tarifa? @relation(fields: [tarifaId], references: [id])

  /// Qué recibe de Aires Majoreros por las limpiezas: FACTURA (documento
  /// fiscal con IGIC) o RESUMEN (solo el detalle, informativo). No todos los
  /// propietarios piden factura: Domingo Javier, por ejemplo, encarga él las
  /// limpiezas y solo quiere el resumen.
  documentoLimpieza String @default("FACTURA")

  properties Property[]
  expenses   Expense[]
  groups     PropertyGroup[]
  cuotas     CuotaFija[]
  facturas   Invoice[]
  informes   EnvioDeInforme[]

  @@index([organizationId])
}

/// Un tramo de cuota fija: cuánto se cobra al mes y desde cuándo.
///
/// No basta con un importe y una fecha porque **la cuota sube**: a Academia
/// Cañada se le empezó cobrando 400 €, luego 500 y luego 600. Con un solo
/// número, un informe de todo el año cobra el último importe también por los
/// meses en que se cobraba menos, y la diferencia se factura.
model CuotaFija {
  id      String    @id @default(cuid())
  ownerId String
  owner   Owner     @relation(fields: [ownerId], references: [id])
  importe Decimal
  desde   DateTime
  /// Nulo mientras sea la que está en vigor.
  hasta   DateTime?

  @@index([ownerId])
}

model Property {
  id                String         @id @default(cuid())
  organizationId    String
  organization      Organization   @relation(fields: [organizationId], references: [id])
  ownerId           String?
  owner             Owner?         @relation(fields: [ownerId], references: [id])
  name              String
  locality          String // localidad en Fuerteventura (Corralejo, Costa Calma...)
  address           String?
  capacity          Int            @default(2)
  bedrooms          Int            @default(1)
  bathrooms         Int            @default(1)
  active            Boolean        @default(true)
  cleaningPrice     Decimal        @default(0)
  /// Solo para una vivienda suelta, que no pertenezca a ningún grupo. Lo
  /// normal es que la comisión venga del grupo: ver `PropertyGroup`.
  managementPct     Decimal?
  groupId           String?
  group             PropertyGroup? @relation(fields: [groupId], references: [id]) // precio que Aires Majoreros factura por limpieza estándar de esta vivienda
  manualStatus      String? // override manual opcional: OCCUPIED | AVAILABLE | CLEANING_NEEDED | MAINTENANCE
  lodgifyPropertyId String?        @unique // para emparejar con la integración Lodgify

  // Lo que el huésped necesita para llegar y entrar. Hoy esto vive en la
  // cabeza de quien contesta el WhatsApp, y por eso se contesta mil veces lo
  // mismo y a deshora. Ver `lib/llegada.ts`.
  /// Cómo se llega de verdad: el desvío que no sale en el mapa, dónde aparcar,
  /// qué portal es. Texto libre porque cada casa tiene lo suyo.
  comoLlegar  String? @db.Text
  /// Enlace al punto exacto en un mapa. Se manda tal cual.
  mapaUrl     String?
  horaEntrada String? // "16:00"
  horaSalida  String? // "10:00"
  wifiRed     String?
  wifiClave   String?
  normas      String? @db.Text
  /// El código de la caja de llaves, cifrado (AES-256-GCM, `lib/secretos.ts`).
  ///
  /// **No sale por correo.** Un correo se queda para siempre en el buzón de
  /// mucha gente, y el código de una caja de llaves no cambia entre huéspedes.
  /// Se guarda aquí para poder mandarlo el día de la entrada por un canal que
  /// caduque, y mientras tanto para no tenerlo en un cuaderno.
  codigoLlaveCifrado String? @db.Text

  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  bookings           Booking[]
  cleaningTasks      CleaningTask[]
  channelCommissions ChannelCommission[]
  expenses           Expense[]
  TarifaVivienda     TarifaVivienda[]

  @@index([organizationId])
}

model Employee {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  role           String       @default("CLEANING") // CLEANING | MAINTENANCE | BOTH
  phone          String?
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())

  cleaningTasks CleaningTask[]

  @@index([organizationId])
}

/// Reserva. Puede venir de Lodgify (lodgifyBookingId presente) o creada a
/// mano. manuallyAdjusted protege la reserva de ser sobrescrita por el sync.
model Booking {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  propertyId     String
  property       Property     @relation(fields: [propertyId], references: [id])

  lodgifyBookingId String? @unique // clave única para upsert idempotente desde Lodgify

  guestName  String
  guestEmail String?
  guestPhone String?
  adults     Int     @default(1)
  children   Int     @default(0)

  checkIn  DateTime
  checkOut DateTime

  channel String @default("DIRECTO") // Airbnb | Booking.com | Lodgify | Directo | ... (lista configurable)
  status  String @default("CONFIRMED") // CONFIRMED | CANCELLED

  totalPrice            Decimal
  platformCommissionPct Decimal @default(0)
  platformCommissionAmt Decimal @default(0)
  bankCommissionPct     Decimal @default(0)
  bankCommissionAmt     Decimal @default(0)
  netAmount             Decimal @default(0)

  manuallyAdjusted Boolean @default(false) // true = el sync de Lodgify nunca debe tocar esta reserva
  notes            String? @db.Text

  source    String   @default("MANUAL") // MANUAL | LODGIFY
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cleaningTasks CleaningTask[]
  huespedes     Huesped[]

  /// Enlace público, de un solo uso y caducable, con el que el huésped
  /// rellena sus datos desde el móvil antes de llegar. Se guarda solo su
  /// huella, igual que el token de importación: se enseña una vez.
  huellaFormulario  String?   @unique
  formularioExpira  DateTime?
  /// Cuándo se comunicaron los viajeros de esta reserva, y el acuse.
  comunicadoEl      DateTime?
  acuseComunicacion String?   @db.Text

  @@index([organizationId])
  @@index([propertyId])
  @@index([checkIn])
  @@index([checkOut])
}

/// Cada vez que se le manda un informe a un propietario.
///
/// No es un adorno: sin esto, «¿le mandamos ya el de septiembre?» solo se
/// puede contestar mirando la bandeja de enviados de un correo concreto, y
/// solo lo sabe quien lo mandó. Aquí queda a quién, cuándo y de qué periodo.
model EnvioDeInforme {
  id      String @id @default(cuid())
  ownerId String
  owner   Owner  @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  periodStart DateTime
  periodEnd   DateTime
  /// A dónde se mandó. Se copia en vez de leerlo del propietario: si mañana
  /// cambia su correo, lo que se mandó se mandó a la dirección de entonces.
  destinatario String?
  /// EMAIL | MANO — «mano» es haberlo dado impreso o por WhatsApp.
  medio     String   @default("EMAIL")
  enviadoEl DateTime @default(now())
  nota      String?  @db.Text

  @@index([ownerId])
  @@index([periodStart])
}

/// Un viajero de una reserva, con los datos que exige el parte de viajeros.
///
/// Real Decreto 933/2021: quien presta alojamiento tiene que registrar e
/// informar los datos de cada viajero a través de SES.HOSPEDAJES. No es un
/// campo más de la reserva: son **datos personales de identificación**, y por
/// eso los sensibles van cifrados (`lib/secretos.ts`, AES-256-GCM) y el
/// registro se borra cuando vence el plazo de conservación.
///
/// ⚠️ La lista de campos está montada con fuentes secundarias coincidentes:
/// el proxy de red de esta sesión bloquea boe.es, interior.gob.es y
/// sede.interior.gob.es, así que **no he podido leer ni el Real Decreto ni la
/// guía oficial**. Antes de comunicar nada de verdad hay que contrastarla con
/// la «Guía visual de Hospedajes» del Ministerio.
model Huesped {
  id        String  @id @default(cuid())
  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  /// El que firma el contrato y responde por el resto. Uno por reserva.
  titular Boolean @default(false)

  // --- Identidad. Todo lo que identifica va cifrado. ---
  nombre    String
  apellido1 String
  apellido2 String?
  /// NIF | NIE | PAS | OTRO
  tipoDocumento String
  /// Cifrado.
  documento     String  @db.Text
  /// El número de soporte del DNI/NIE. Cifrado. No es el número del
  /// documento: es el que lleva impreso al lado y cambia al renovarlo.
  numeroSoporte String? @db.Text
  /// ISO 3166-1 alfa-3.
  nacionalidad  String
  fechaNacimiento DateTime
  /// M | F | O
  sexo String?

  // --- Residencia y contacto ---
  direccion  String? @db.Text
  municipio  String?
  provincia  String?
  pais       String?
  codigoPostal String?
  telefono   String?
  email      String?

  /// Parentesco con el titular. Obligatorio cuando el viajero es menor de
  /// edad: sus datos los da el adulto que lo acompaña.
  parentesco String?

  creadoEl     DateTime @default(now())
  actualizadoEl DateTime @updatedAt

  @@index([bookingId])
}

/// Registro compartido entre los dos negocios: es a la vez tarea operativa
/// (Emma: calendario/asignación) y línea facturable (Aires Majoreros:
/// facturación), sin duplicarse en dos tablas distintas.
model CleaningTask {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  propertyId     String
  property       Property     @relation(fields: [propertyId], references: [id])

  bookingId String? // limpieza asociada a la salida de esta reserva (opcional)
  booking   Booking? @relation(fields: [bookingId], references: [id])

  type   String   @default("CLEANING") // CLEANING | MAINTENANCE
  date   DateTime
  status String   @default("PENDING") // PENDING | IN_PROGRESS | DONE | CANCELLED

  /// salida | repaso. Solo para las de type=CLEANING: la tarifa cobra distinto
  /// por una y por otra (60 € frente a 40 € en la «Oficial 2026»). Lo decide
  /// el hueco hasta la siguiente entrada; ver `lib/limpiezas.ts`.
  servicio String?
  /// Con cuántos huéspedes se calculó el precio — los de quien se va. Se
  /// guarda en vez de mirarlo en la reserva cada vez: si mañana alguien
  /// corrige la reserva, la limpieza ya facturada no puede cambiar sola.
  huespedes Int?

  employeeId String?
  employee   Employee? @relation(fields: [employeeId], references: [id])

  billable Boolean @default(true) // solo las de type=CLEANING generan factura a Aires Majoreros
  price    Decimal @default(0) // importe que se factura por esta limpieza

  invoiceId String?
  invoice   Invoice? @relation(fields: [invoiceId], references: [id])

  notes     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([propertyId])
  @@index([date])
  @@index([status])
  @@index([invoiceId])
}

// ---------------------------------------------------------------------------
// Negocio de facturación de limpiezas (Aires Majoreros)
// ---------------------------------------------------------------------------

model Partner {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  email          String?
  createdAt      DateTime     @default(now())

  @@index([organizationId])
}

/// Reparto configurable del importe facturado entre las socias. Por defecto
/// 50/50, pero editable y con vigencia temporal (effectiveFrom) para permitir
/// cambios futuros sin perder el histórico.
model PartnerSplitConfig {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id])
  partnerAId      String
  partnerBId      String
  partnerAPercent Decimal      @default(50)
  partnerBPercent Decimal      @default(50)
  effectiveFrom   DateTime     @default(now())
  createdAt       DateTime     @default(now())

  @@index([organizationId])
}

model Invoice {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  /// FACTURA (documento fiscal, con IGIC y numeración correlativa propia) o
  /// RESUMEN (informativo, sin impuesto y con su propia serie). Un resumen no
  /// consume número de factura: la serie fiscal tiene que quedar correlativa.
  tipoDocumento String @default("FACTURA")

  /// A quién se le factura. Los clientes de Aires Majoreros son **los
  /// propietarios de las viviendas**, uno por documento, no el negocio de
  /// alquiler. Se guarda además el nombre y los datos fiscales copiados, que
  /// es lo que sale impreso: cambiar mañana la ficha del propietario no puede
  /// alterar una factura ya emitida.
  ownerId String?
  owner   Owner?  @relation(fields: [ownerId], references: [id])

  invoiceNumber   String   @unique
  billedToName    String // cliente facturado: la razón social del propietario
  billedToTaxId   String?
  /// Domicilio del destinatario, también obligatorio en la factura.
  billedToAddress String?  @db.Text
  periodStart     DateTime
  periodEnd       DateTime
  issueDate       DateTime @default(now())
  status          String   @default("DRAFT") // DRAFT | ISSUED | PAID

  /// Base imponible: la suma de las líneas, antes de impuestos.
  subtotal  Decimal @default(0)
  /// Tipo y cuota del impuesto, tal como estaban el día de emitirla. Se
  /// guardan en la factura y no se recalculan: una factura emitida no cambia.
  taxRate   Decimal @default(7)
  taxAmount Decimal @default(0)
  /// Base imponible + cuota.
  total     Decimal @default(0)

  partnerAId      String?
  partnerBId      String?
  partnerAPercent Decimal @default(50)
  partnerBPercent Decimal @default(50)
  partnerAAmount  Decimal @default(0)
  partnerBAmount  Decimal @default(0)

  notes     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines        CleaningTask[]
  invoiceLines InvoiceLine[]

  @@index([organizationId])
  @@index([ownerId])
}

/// Copia inmutable de cada línea en el momento de facturar (snapshot), para
/// que la factura no cambie si luego se edita la vivienda o el precio.
model InvoiceLine {
  id             String   @id @default(cuid())
  invoiceId      String
  invoice        Invoice  @relation(fields: [invoiceId], references: [id])
  cleaningTaskId String?
  description    String
  propertyName   String
  date           DateTime
  amount         Decimal

  @@index([invoiceId])
}

// ---------------------------------------------------------------------------
// Integraciones y configuración
// ---------------------------------------------------------------------------

/// Comisión que se lleva cada canal de venta.
///
/// Antes había un único porcentaje para todo, y no es así: Airbnb se lleva el
/// 15 % y Booking.com el 18 %. Aplicar el mismo a las dos descuadra el neto de
/// cada reserva, y con él los informes del año.
///
/// El canal se guarda tal cual lo manda Lodgify, pero se compara en minúsculas
/// y sin espacios: «Booking.com», «booking.com» y «BOOKING.COM» son el mismo.
model ChannelCommission {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  /// Nombre del canal tal como lo manda Lodgify.
  channel        String
  /// Si se indica, esta comisión vale solo para esa vivienda; si es nula, vale
  /// para todas las de ese canal. Booking no cobra lo mismo a todos los pisos:
  /// en los datos reales son 17 % en dos de ellos y 15 % en el resto.
  propertyId     String?
  property       Property?    @relation(fields: [propertyId], references: [id])
  platformPct    Decimal      @default(0)
  /// Comisión bancaria de este canal. Nula = la general. Airbnb no cobra
  /// ninguna; Booking, un 1,3 %.
  bankPct        Decimal?
  /// Si el porcentaje está comprobado contra papeles reales o es un supuesto.
  /// Mirador traía los suyos marcados «SUPUESTO, pendiente de contrastar»; un
  /// supuesto que no se distingue de un dato comprobado acaba en una factura.
  confirmado     Boolean      @default(true)
  /// De dónde sale el porcentaje, para poder discutirlo.
  nota           String?      @db.Text
  createdAt      DateTime     @default(now())

  @@unique([organizationId, channel, propertyId])
  @@index([organizationId])
  @@index([propertyId])
}

/// Un grupo de viviendas de un mismo propietario, con su comisión.
///
/// Inversiones Brito tiene dos, y cobran distinto: el Grupo Villa Mónica al
/// 30 % y Villa Monikka al 10 %. Sin esto habría que repetir el porcentaje en
/// cada una de las once viviendas, y a la primera que se olvidara, descuadra.
///
/// La cuota fija (Academia Cañada, 600 € al mes) no va aquí: esa es del
/// propietario entero, no de un grupo.
model PropertyGroup {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  ownerId        String
  owner          Owner        @relation(fields: [ownerId], references: [id])
  name           String
  /// Lo que se lleva Aires por gestionar las viviendas de este grupo, sobre
  /// lo que queda después de las comisiones de venta y de los gastos.
  managementPct  Decimal?
  createdAt      DateTime     @default(now())

  properties Property[]
  expenses   Expense[]

  @@index([organizationId])
  @@index([ownerId])
}

/// Un gasto de una vivienda: luz, agua, una reparación, la comunidad.
///
/// Hace falta para los informes al propietario: la comisión de gestión se
/// calcula sobre lo que queda **después de gastos**, así que sin ellos el
/// número sale siempre alto. Los sube Emma.
model Expense {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  /// La vivienda a la que se imputa. Si es nula, es un gasto del propietario
  /// que no va contra una casa concreta.
  propertyId     String?
  property       Property?    @relation(fields: [propertyId], references: [id])
  ownerId        String?
  owner          Owner?       @relation(fields: [ownerId], references: [id])

  /// El grupo al que se imputa, cuando el gasto no es de una vivienda
  /// concreta sino de todo un grupo (una compra que sirve para los cinco
  /// apartamentos, el sueldo de quien limpia en todos).
  groupId String?
  group   PropertyGroup? @relation(fields: [groupId], references: [id])

  /// gasto | sueldo | traspaso | ingreso. Un traspaso entre cuentas no es un
  /// gasto y no puede restar en la liquidación; un sueldo sí, pero se mira
  /// aparte. Mezclarlos los hace desaparecer dentro de «gastos».
  type       String  @default("gasto")
  /// `directo` si es de una vivienda; `compartido` si hay que repartirlo
  /// entre las del grupo en proporción a lo que factura cada una.
  reparto    String  @default("directo")
  /// De dónde salió: `banco` (extracto), `factura_ocr` (una factura leída),
  /// `manual`. Sin esto no se distingue un apunte con justificante de uno
  /// que solo es una línea del banco.
  origen     String?
  /// Huella del apunte en su origen. Impide importar dos veces lo mismo.
  origenHash String? @unique
  /// Lo que hay que mirar de este apunte: «sin fecha en el fichero», «el
  /// texto no identifica el grupo». Viaja con el dato, no en un log.
  revisar    String? @db.Text

  date     DateTime?
  concept  String
  supplier String?
  amount   Decimal   @default(0)
  notes    String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([propertyId])
  @@index([groupId])
  @@index([date])
  @@index([type])
}

model IntegrationSettings {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  provider       String       @default("LODGIFY")

  apiKeyMasked       String? // versión enmascarada, para enseñarla sin enseñarla
  /// Clave de API cifrada con AES-256-GCM (ver `lib/secretos.ts`). Antes no
  /// se guardaba: la que se escribía en Ajustes se tiraba y la sincronización
  /// seguía en modo demostración sin decir nada.
  apiKeyCifrada      String?   @db.Text
  defaultPlatformPct Decimal   @default(15)
  defaultBankPct     Decimal   @default(2.5)
  syncEnabled        Boolean   @default(true)
  lastSyncAt         DateTime?
  lastSyncSummary    String?   @db.Text

  @@unique([organizationId, provider])
}

// ---------------------------------------------------------------------------
// Usuarios / acceso
// ---------------------------------------------------------------------------

model User {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  email          String       @unique
  passwordHash   String
  role           String       @default("STAFF") // ADMIN | RENTAL_MANAGER | PARTNER | STAFF
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())

  documentosSubidos DocumentoOcr[] @relation("DocumentosSubidos")

  @@index([organizationId])
}

/// Una factura de gasto subida para que la lea la máquina.
///
/// Nada de lo que devuelve el modelo entra directo en `Expense`. Cae aquí,
/// una persona lo revisa, y el alta real se hace al confirmar. Sin eso, el
/// resto de comprobaciones serían decorativas: bastaría un descuido para que
/// un total mal leído acabara descontado en la liquidación de un propietario.
model DocumentoOcr {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  subidoPorId    String?
  subidoPor      User?        @relation("DocumentosSubidos", fields: [subidoPorId], references: [id])

  /// pendiente | registrado | descartado
  estado String @default("pendiente")

  // ── El original ────────────────────────────────────────────────────
  // Se guarda siempre, aunque la lectura falle después: el justificante es
  // lo que hace falta el día que haya una comprobación.
  //
  // Va en la base y no en disco porque Hostinger borra todo lo que se
  // escriba dentro del directorio de la aplicación en cada despliegue.
  archivoNombre String
  archivoMime   String
  archivoBytes  Int
  /// SHA-256, para no pagar dos veces por el mismo documento.
  archivoHash   String
  contenido     Bytes

  // ── Lo que dijo el modelo ──────────────────────────────────────────
  /// Respuesta literal. No se modifica nunca: es la única referencia que
  /// hay para medir si el modelo acierta.
  datosIa     String?  @db.Text
  confianzaIa String?
  /// La que calcula el código, de 0 a 1. Es la que ordena la bandeja.
  fiabilidad  Decimal?
  motivos     String?  @db.Text
  avisos      String?  @db.Text

  // ── Lo que quedó tras la revisión ──────────────────────────────────
  /// Se guarda aunque no cambie nada: «una persona miró esto y lo dio por
  /// bueno» es justo el dato que dice si el modelo acierta.
  datosRevisados String?   @db.Text
  revisadoPorId  String?
  revisadoEn     DateTime?

  // ── Coste y versión ────────────────────────────────────────────────
  modelo        String?
  promptVersion String?
  tokensEntrada Int?
  tokensSalida  Int?
  /// Servidos desde caché. Cero constante con prefijo estable = hay algo
  /// que lo invalida.
  tokensCache   Int?
  errorLectura  String? @db.Text

  /// Se rellena al registrar el gasto.
  expenseId String?
  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([estado])
  @@index([archivoHash])
}

/// Una lista de precios de limpieza, con su vigencia.
///
/// Hay dos en marcha: «Oficial 2026» y una propia de Inversiones Brito, más
/// barata por ser el cliente grande. Subir precios crea una tarifa nueva con
/// su fecha, no se pisa la anterior: lo facturado el mes pasado no puede
/// cambiar retroactivamente.
model Tarifa {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  vigenteDesde   DateTime
  vigenteHasta   DateTime?
  createdAt      DateTime     @default(now())

  lineas TarifaLinea[]
  owners Owner[]

  @@index([organizationId])
}

/// Lo que cuesta un servicio en una tarifa: una base con unos huéspedes
/// incluidos y un suplemento por cada uno que pase de ahí.
model TarifaLinea {
  id                  String  @id @default(cuid())
  tarifaId            String
  tarifa              Tarifa  @relation(fields: [tarifaId], references: [id], onDelete: Cascade)
  /// salida | repaso
  servicio            String
  base                Decimal @default(0)
  huespedesIncluidos  Int     @default(0)
  porHuespedAdicional Decimal @default(0)

  @@unique([tarifaId, servicio])
}

/// El precio cerrado de una vivienda, que gana sobre la tarifa.
///
/// Villa Mónica son 120 € vengan los que vengan: es una casa de quince plazas
/// y se limpia entera. Villa Gregorio y Villa Caliche, 100 €.
model TarifaVivienda {
  id            String   @id @default(cuid())
  propertyId    String
  property      Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  /// salida | repaso
  servicio      String
  precioCerrado Decimal

  @@unique([propertyId, servicio])
}
